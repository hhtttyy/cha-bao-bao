.page { padding: 28rpx 28rpx 150rpx; }

.empty { text-align: center; padding-top: 120rpx; }
.empty-circle {
  width: 160rpx; height: 160rpx; margin: 0 auto;
  border-radius: 50%;
  background: linear-gradient(135deg, #f6ecd8, #f0e0c0);
  display: flex; align-items: center; justify-content: center;
  font-size: 76rpx;
}
.empty-text { font-size: 34rpx; font-weight: 700; color: #1f3d2e; margin-top: 28rpx; }
.empty-sub { font-size: 28rpx; color: #8a9086; margin-top: 10rpx; }
.empty-cta { margin: 40rpx auto 0; width: 70%; }

.item-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.village { font-size: 32rpx; font-weight: 700; color: #1f3d2e; }
.level { font-size: 24rpx; padding: 6rpx 18rpx; border-radius: 999rpx; color: #fff; font-weight: 600; }
.lv-light { background: #c08a2e; }
.lv-mid { background: #c8503c; }
.lv-heavy { background: #8a3a28; }
.item-body { font-size: 28rpx; color: #3d6b52; line-height: 1.6; }
.item-time { font-size: 24rpx; color: #8a9086; margin-top: 12rpx; }