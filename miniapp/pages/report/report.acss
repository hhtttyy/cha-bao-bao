.page { padding: 32rpx 28rpx 60rpx; }

/* 三步进度指示 */
.steps-bar { display: flex; align-items: center; justify-content: center; margin: 8rpx 0 32rpx; }
.sb { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.sb-dot {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #ffffff; border: 2rpx solid #e7e1d3; color: #8a9086;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700; transition: all .2s ease;
}
.sb-t { font-size: 24rpx; color: #8a9086; }
.sb.done .sb-dot { background: #2f6b4f; border-color: #2f6b4f; color: #fff; }
.sb.done .sb-t { color: #2f6b4f; font-weight: 600; }
.sb.ready .sb-dot { background: #c08a2e; border-color: #c08a2e; color: #fff; }
.sb.ready .sb-t { color: #c08a2e; font-weight: 600; }
.sb-line { width: 72rpx; height: 3rpx; background: #e7e1d3; margin: 0 12rpx 32rpx; }
.sb-line.done { background: #2f6b4f; }

.step-title { font-size: 34rpx; font-weight: 700; color: #1f3d2e; margin: 28rpx 0 18rpx; }

/* 拍照框 */
.photo-box {
  position: relative;
  height: 380rpx; border-radius: 24rpx; overflow: hidden;
  background: #f6ecd8; border: 3rpx dashed #c08a2e;
  display: flex; align-items: center; justify-content: center;
  transition: border-color .2s ease;
}
.photo-box.has { border-style: solid; border-color: #2f6b4f; }
.photo { width: 100%; height: 100%; }
.photo-badge {
  position: absolute; left: 16rpx; bottom: 16rpx;
  background: rgba(31,61,46,.82); color: #fff;
  font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 999rpx;
}
.photo-empty { text-align: center; padding: 0 40rpx; }
.photo-icon { font-size: 72rpx; }
.photo-hint { font-size: 28rpx; color: #c08a2e; margin-top: 12rpx; line-height: 1.5; }

/* 定位卡片 */
.loc-card {
  margin-top: 16rpx; background: #ffffff; border: 1rpx solid #e7e1d3;
  border-radius: 20rpx; padding: 24rpx;
}
.loc-head { display: flex; justify-content: space-between; align-items: center; }
.loc-title { font-size: 30rpx; font-weight: 700; color: #1f3d2e; }
.loc-state { font-size: 24rpx; padding: 4rpx 18rpx; border-radius: 999rpx; background: #f0ece2; color: #8a9086; }
.loc-state.ok { background: #e4f0e8; color: #2f6b4f; }
.loc-state.locating { background: #f6ecd8; color: #c08a2e; }
.loc-state.denied, .loc-state.fail { background: #f7e6e0; color: #c8503c; }
.loc-value { font-size: 28rpx; color: #2f6b4f; font-weight: 600; margin-top: 14rpx; }
.loc-tip { font-size: 26rpx; color: #8a9086; margin-top: 14rpx; line-height: 1.6; }
.loc-actions { display: flex; gap: 16rpx; margin-top: 18rpx; }
.loc-btn {
  flex: 1; text-align: center; padding: 16rpx 0; border-radius: 999rpx;
  background: linear-gradient(135deg, #3a8a68, #2f6b4f); color: #fff;
  font-size: 28rpx; font-weight: 600;
}
.loc-btn.ghost { background: #ffffff; border: 1rpx solid #c08a2e; color: #c08a2e; }

/* 录音 */
.voice-wrap { border-radius: 24rpx; }
.voice-btn {
  display: flex; align-items: center; justify-content: center; gap: 16rpx;
  background: linear-gradient(135deg, #d19a3a, #c08a2e); color: #fff;
  border-radius: 24rpx; padding: 34rpx 0; text-align: center;
  font-size: 34rpx; font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(192,138,46,.26);
  transition: transform .12s ease;
}
.voice-btn:active { transform: scale(.98); }
.voice-btn.recording { background: linear-gradient(135deg, #d0604a, #c8503c); animation: pulse 1.2s ease-out infinite; }
.wave { display: inline-flex; gap: 5rpx; align-items: flex-end; height: 32rpx; }
.wave i { width: 5rpx; background: #fff; border-radius: 3rpx; height: 100%; transform-origin: bottom; animation: wv .9s ease-in-out infinite; }
.wave i:nth-child(2){animation-delay:.12s}.wave i:nth-child(3){animation-delay:.24s}.wave i:nth-child(4){animation-delay:.36s}.wave i:nth-child(5){animation-delay:.48s}.wave i:nth-child(6){animation-delay:.6s}

.voice-bar {
  margin-top: 16rpx; background: #f6ecd8; border: 1rpx solid #c08a2e;
  border-radius: 16rpx; padding: 18rpx 22rpx; display: flex; align-items: center;
  transition: background .2s ease;
}
.voice-bar.on { background: #f0e0c0; }
.play-icon { font-size: 32rpx; color: #c08a2e; margin-right: 14rpx; }
.play-text { font-size: 28rpx; color: #3d6b52; }

.submit { margin-top: 44rpx; }
.note { margin-top: 22rpx; font-size: 24rpx; color: #8a9086; line-height: 1.6; text-align: center; }

/* 诊断日志面板 */
.dbg-bar { display: flex; gap: 16rpx; margin-top: 28rpx; }
.dbg-toggle {
  flex: 1; text-align: center; padding: 14rpx 0; border-radius: 999rpx;
  background: #1f3d2e; color: #cfe6d8; font-size: 26rpx; font-weight: 600;
}
.dbg-toggle.ghost { background: #ffffff; border: 1rpx solid #1f3d2e; color: #1f3d2e; }
.dbg-panel {
  margin-top: 16rpx; height: 420rpx; background: #101613; border-radius: 16rpx;
  padding: 20rpx; box-sizing: border-box;
}
.dbg-text { font-size: 22rpx; color: #9fd8b4; line-height: 1.7; font-family: Menlo, Consolas, monospace; word-break: break-all; }