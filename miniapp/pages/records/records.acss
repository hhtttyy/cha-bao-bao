.page { padding: 28rpx 28rpx 150rpx; }

.empty { text-align: center; padding-top: 140rpx; }
.empty-circle {
  width: 160rpx; height: 160rpx; margin: 0 auto;
  border-radius: 50%;
  background: linear-gradient(135deg, #e4f0e8, #d3e8dc);
  display: flex; align-items: center; justify-content: center;
  font-size: 76rpx;
}
.empty-text { font-size: 34rpx; font-weight: 700; color: #1f3d2e; margin-top: 28rpx; }
.empty-sub { font-size: 28rpx; color: #8a9086; margin-top: 10rpx; }

.card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.time { font-size: 28rpx; color: #3d6b52; }
.status { font-size: 26rpx; padding: 6rpx 20rpx; border-radius: 999rpx; font-weight: 600; }
.status.ok { background: #e4f0e8; color: #2f6b4f; }
.status.wait { background: #f7e6e0; color: #c8503c; }
.thumb { width: 100%; height: 300rpx; border-radius: 16rpx; }
.meta { font-size: 26rpx; color: #3d6b52; margin-top: 12rpx; }
.voice-chip {
  display: inline-block; margin-top: 16rpx;
  background: #f6ecd8; border: 1rpx solid #c08a2e; color: #c08a2e;
  border-radius: 999rpx; padding: 10rpx 26rpx; font-size: 26rpx; font-weight: 600;
  transition: all .15s ease;
}
.voice-chip.on { background: #c08a2e; color: #ffffff; }