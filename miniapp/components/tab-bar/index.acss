.tabbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 99;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #e7e1d3;
  padding: 14rpx 0;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 24rpx rgba(31, 61, 46, 0.08);
}
.tab { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.tab-ico { font-size: 42rpx; filter: grayscale(1); opacity: 0.5; transition: opacity 0.15s ease; }
.tab-t { font-size: 30rpx; color: #8a9086; font-weight: 500; letter-spacing: 1rpx; }
.tab.on .tab-ico { filter: none; opacity: 1; }
.tab.on .tab-t { color: #2f6b4f; font-weight: 700; }